{
  "opencollection": "1.0.0",
  "info": {
    "name": "BILL v3 Authentication Organizations API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "sessionId",
      "value": "{{sessionId}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Organizations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List accessible organizations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.prod.bill.com/connect/v3/organizations"
          },
          "docs": "List accessible organizations"
        },
        {
          "info": {
            "name": "Restore an archived user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://gateway.prod.bill.com/connect/v3/users/:userId/restore",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Restore an archived user"
        }
      ]
    }
  ],
  "bundled": true
}